print("Vítejte v aplikaci na objednáni pizzy")
size = input("Jakou velikost pizzy chcete? S, M nebo L. ")
chilli_peppers = input("Chcete feferonky? A nebo N. ")
extra_cheese = input("Chcete extra sýr? A nebo N. ")

bill = 0

if size == "S":
    bill += 100

elif size == "M":
    bill += 150 
elif size == "L":
    bill += 200

if chilli_peppers == "A":
    if size != "S":
        bill += 30
    else:
        bill += 20    

if extra_cheese == "A":
    bill += 15


print(f"Částka k zaplacení: {bill} Kč")
